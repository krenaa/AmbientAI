# =================================================================
# AmbientDesk AI — Pure FastAPI Environment Configuration
# =================================================================

# --- Application Info ---
APP_NAME="AmbientDesk AI Backend"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt-and-sessions

# --- AI Provider Keys & Resilient Multi-Model Cascading Fallbacks ---
# Primary & backup Groq keys (comma-separated if using multiple keys):
GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_MODEL=llama-3.3-70b-versatile

# Primary & backup Google Gemini keys (comma-separated if using multiple keys):
GOOGLE_API_KEY=AIza...
# GOOGLE_API_KEYS=AIza_key1,AIza_key2
GOOGLE_MODEL=gemini-2.0-flash

# Optional OpenAI keys:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

TAVILY_API_KEY=tvly-...

# --- Observability (LangSmith) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ambientdesk-prod

# --- PostgreSQL Database (Users, Tasks, pgvector RAG) ---
# For Supabase / Neon / Managed Postgres: set DATABASE_URL (Transaction pooler or direct connection)
# Example: DATABASE_URL=postgresql+psycopg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Or local PostgreSQL credentials:
POSTGRES_DB=ambientdesk_db
POSTGRES_USER=ambientdesk_user
POSTGRES_PASSWORD=ambientdesk_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS Configuration ---
# Comma-separated or default origins handled in config.py
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Real Email / SMTP Configuration (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true