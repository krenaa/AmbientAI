# --- AI Provider Keys ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.0-flash
TAVILY_API_KEY=tvly-...

# --- Observability ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ambientdesk-prod

# --- Database & Cache ---
POSTGRES_DB=ambientdesk_db
POSTGRES_USER=ambientdesk_user
POSTGRES_PASSWORD=ambientdesk_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# --- Service Communication ---
AI_AGENT_SERVICE_URL=http://localhost:8001
AI_AGENT_INTERNAL_TOKEN=change-me-to-a-secure-random-secret

# --- Django Security ---
DJANGO_SECRET_KEY=django-insecure-generate-a-strong-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to True when running in production with HTTPS / SSL:
SECURE_SSL_REDIRECT=False

# --- Real Email / SMTP Configuration (Optional: for delivering real emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true