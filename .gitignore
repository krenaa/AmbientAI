# =================================================================
# AmbientDesk AI — Production .gitignore
# =================================================================

# --- Environment Variables & Secrets (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# --- Node / React / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs, Databases & Runtime Files ---
*.log
logs/
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- IDEs & OS Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-workspace
*.sublime-project